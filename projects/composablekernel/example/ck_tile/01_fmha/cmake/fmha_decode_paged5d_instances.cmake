# Object library fmha_decode_paged5d_instances: the translation units that instantiate
# fmha_decode_paged5d::launch_instance, one per cache layout, page size, head dim, tiles per
# workgroup and scale granularity so that they compile in parallel. Every target that includes
# fmha_decode_paged5d_runner.hpp links its objects.
function(fmha_decode_paged5d_instances gpu_targets example_dir)
  if(TARGET fmha_decode_paged5d_instances)
    return()
  endif()
  set(dir ${CMAKE_BINARY_DIR}/fmha_decode_paged5d_instances)
  set(sources)
  foreach(layout shuffle_5d hnd nhd)
    foreach(page_size 16 64 128)
      foreach(hdim 64 128 256)
        foreach(m_tiles 1 2)
          foreach(per_token false true)
            set(name ${layout}_p${page_size}_d${hdim}_m${m_tiles}_pt${per_token})
            set(file ${dir}/decode_paged5d_launch_${name}.cpp)
            file(CONFIGURE OUTPUT ${file} CONTENT
"// Copyright (c) Advanced Micro Devices, Inc., or its affiliates.
// SPDX-License-Identifier: MIT
// Generated by fmha_decode_paged5d_instances.cmake.

#include \"fmha_decode_paged5d_runner.hpp\"

namespace fmha_decode_paged5d {
FMHA_DECODE_PAGED5D_INSTANCE(template, ${page_size}, false, ${layout}, ${hdim}, ${m_tiles}, ${per_token})
FMHA_DECODE_PAGED5D_INSTANCE(template, ${page_size}, true, ${layout}, ${hdim}, ${m_tiles}, ${per_token})
} // namespace fmha_decode_paged5d
" @ONLY)
            list(APPEND sources ${file})
          endforeach()
        endforeach()
      endforeach()
    endforeach()
  endforeach()
  add_library(fmha_decode_paged5d_instances OBJECT EXCLUDE_FROM_ALL ${sources})
  set_property(TARGET fmha_decode_paged5d_instances PROPERTY HIP_ARCHITECTURES ${gpu_targets})
  set_property(TARGET fmha_decode_paged5d_instances PROPERTY POSITION_INDEPENDENT_CODE ON)
  target_include_directories(fmha_decode_paged5d_instances PRIVATE ${example_dir})
endfunction()
