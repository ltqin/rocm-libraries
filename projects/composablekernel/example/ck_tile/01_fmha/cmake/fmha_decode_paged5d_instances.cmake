# Writes the translation units that instantiate fmha_decode_paged5d::launch_page, one per cache
# layout and page size so that they compile in parallel, and returns their paths in out_var.
# Every target that includes fmha_decode_paged5d_runner.hpp links them.
function(fmha_decode_paged5d_instance_sources out_var)
  set(dir ${CMAKE_CURRENT_BINARY_DIR}/fmha_decode_paged5d_instances)
  set(sources)
  foreach(layout shuffle_5d hnd nhd)
    foreach(page_size 16 64 128)
      set(file ${dir}/decode_paged5d_launch_${layout}_p${page_size}.cpp)
      file(CONFIGURE OUTPUT ${file} CONTENT
"// Copyright (c) Advanced Micro Devices, Inc., or its affiliates.
// SPDX-License-Identifier: MIT
// Generated by fmha_decode_paged5d_instances.cmake.

#include \"fmha_decode_paged5d_runner.hpp\"

namespace fmha_decode_paged5d {
FMHA_DECODE_PAGED5D_INSTANCE(template, ${page_size}, false, ${layout})
FMHA_DECODE_PAGED5D_INSTANCE(template, ${page_size}, true, ${layout})
} // namespace fmha_decode_paged5d
" @ONLY)
      list(APPEND sources ${file})
    endforeach()
  endforeach()
  set(${out_var} ${sources} PARENT_SCOPE)
endfunction()
